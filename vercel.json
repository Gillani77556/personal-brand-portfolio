{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/asim-seowala-elementor-template.json",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"asim-seowala-elementor-template.json\""
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/asim-seowala-portfolio.zip",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"asim-seowala-portfolio.zip\""
        },
        {
          "key": "Content-Type",
          "value": "application/zip"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

